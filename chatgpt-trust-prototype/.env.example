# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit your real API key.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — only if frontend and API are on different Netlify sites (see NETLIFY-DEPLOY.md)
# NEXT_PUBLIC_API_BASE_URL=https://your-api-site.netlify.app
